{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "jdtls": {
      "command": ["/run/current-system/sw/bin/jdtls"],
      "extensions": [".java"]
    }
  },
  "providers": {
    "ninfer": {
      "name": "Ninfer (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "inkling-2-mini": {
          "name": "Inkling 2 Mini",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 131072
          }
        }
      }
    },
    "ninfer-remote": {
      "name": "Ninfer (remote)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://100.72.125.9:8080/v1"
      },
      "models": {
        "inkling-2-mini": {
          "name": "Inkling 2 Mini",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 131072
          }
        }
      }
    }
  }
}
