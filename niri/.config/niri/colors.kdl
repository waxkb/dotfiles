layout {
    gaps 8
    focus-ring {
        off
        active-color "#b08bc1"
        inactive-color "#ffffff"
        width 2
    }

    border {
        on
        width 2
        active-color "#b08bc1"
        inactive-color "#201a23"
        urgent-color "#fd4663"
    }

    shadow {
        off
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    always-center-single-column
}
